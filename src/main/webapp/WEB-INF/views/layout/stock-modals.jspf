<%-- Stock-out and adjustment dialogs, shared by the medicine page and the inventory page.
     Expects stockReturnTo (local path to return to after the action). --%>
<c:if test="${perm.STOCK_OUT}">
<div class="modal fade" id="stockOutModal" tabindex="-1" aria-labelledby="stockOutTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content needs-validation" method="post" action="${ctx}/inventory/stock-out" novalidate data-once>
            <ui:csrf/>
            <input type="hidden" name="batchId" data-field="batchId">
            <input type="hidden" name="returnTo" value="${fn:escapeXml(stockReturnTo)}">
            <div class="modal-header">
                <h2 class="modal-title h5" id="stockOutTitle">Remove stock</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Batch <strong data-field="label"></strong> &middot; <span data-field="quantity"></span> unit(s) on hand.</p>
                <p class="text-muted small">Use this for damaged, returned or disposed stock (including expired batches). Sales are recorded through Dispensing instead.</p>
                <div class="mb-3">
                    <label class="form-label" for="so_quantity">Quantity to remove <span class="req" aria-hidden="true">*</span></label>
                    <input class="form-control" id="so_quantity" name="quantity" type="number" min="1" step="1" required data-max-field="quantity" data-autofocus>
                    <div class="invalid-feedback">Enter a whole number between 1 and the quantity on hand.</div>
                </div>
                <div>
                    <label class="form-label" for="so_reason">Reason <span class="req" aria-hidden="true">*</span></label>
                    <input class="form-control" id="so_reason" name="reason" type="text" maxlength="300" required placeholder="e.g. Damaged in storage, Expired - disposed">
                    <div class="invalid-feedback">A reason is required for the stock ledger.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Remove stock</button>
            </div>
        </form>
    </div>
</div>
</c:if>
<c:if test="${perm.STOCK_ADJUST}">
<div class="modal fade" id="adjustModal" tabindex="-1" aria-labelledby="adjustTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content needs-validation" method="post" action="${ctx}/inventory/adjust" novalidate data-once>
            <ui:csrf/>
            <input type="hidden" name="batchId" data-field="batchId">
            <input type="hidden" name="returnTo" value="${fn:escapeXml(stockReturnTo)}">
            <div class="modal-header">
                <h2 class="modal-title h5" id="adjustTitle">Adjust stock</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Batch <strong data-field="label"></strong> &middot; <span data-field="quantity"></span> unit(s) on hand.</p>
                <p class="text-muted small">Corrects a difference found during a stock count. The adjustment is added to the ledger; earlier entries are never changed.</p>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="adj_direction">Adjustment <span class="req" aria-hidden="true">*</span></label>
                        <select class="form-select" id="adj_direction" name="direction" required>
                            <option value="in">Increase (+)</option>
                            <option value="out">Decrease (-)</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="adj_quantity">Quantity <span class="req" aria-hidden="true">*</span></label>
                        <input class="form-control" id="adj_quantity" name="quantity" type="number" min="1" step="1" required data-autofocus>
                        <div class="invalid-feedback">Enter a whole number greater than zero.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="adj_reason">Reason <span class="req" aria-hidden="true">*</span></label>
                        <input class="form-control" id="adj_reason" name="reason" type="text" maxlength="300" required placeholder="e.g. Stock count correction">
                        <div class="invalid-feedback">A reason is required for the stock ledger.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Record adjustment</button>
            </div>
        </form>
    </div>
</div>
</c:if>
