<%-- Closes the page chrome; holds the toast area, the shared confirmation dialog and the scripts. --%>
        </main>
        <footer class="app-footer d-print-none"><c:out value="${settings.pharmacy_name}"/> &middot; Pharmacy Prescription Management System</footer>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" id="toastArea" aria-live="polite" aria-atomic="true">
    <c:if test="${not empty flash}">
        <div class="toast app-toast toast-${flash.type}" role="${flash.type == 'danger' ? 'alert' : 'status'}" data-autoshow data-bs-delay="${flash.type == 'danger' ? 9000 : 5000}">
            <div class="d-flex">
                <div class="toast-body">
                    <c:choose>
                        <c:when test="${flash.type == 'success'}"><ui:icon name="check-circle"/></c:when>
                        <c:when test="${flash.type == 'danger'}"><ui:icon name="x-circle"/></c:when>
                        <c:otherwise><ui:icon name="info-circle"/></c:otherwise>
                    </c:choose>
                    <span><c:out value="${flash.message}"/></span>
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </c:if>
</div>

<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="confirmTitle">Please confirm</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmOk">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script src="${ctx}/assets/vendor/bootstrap.bundle.min.js"></script>
<script src="${ctx}/assets/js/app.js"></script>
<c:if test="${not empty pageScript}"><c:forTokens var="script" items="${pageScript}" delims=",">
<script src="${ctx}/assets/${script}"></script></c:forTokens></c:if>
</body>
</html>
