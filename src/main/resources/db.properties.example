# Option B: properties file.
# Copy this file to  src/main/resources/db.properties  (it is ignored by Git)
# and put your own MySQL user and password here, then rebuild the WAR.
# Environment variables with the same names override these values.

DB_URL=jdbc:mysql://localhost:3306/pharmacy_db?useUnicode=true&characterEncoding=UTF-8
DB_USER=pharmacy_app
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_POOL_SIZE=10

# One-time secret typed on the /setup page to create the first administrator.
SETUP_TOKEN=choose-a-long-random-value

COOKIE_SECURE=false
