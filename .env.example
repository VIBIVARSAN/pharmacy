# Option A: environment variables (they win over db.properties).
# Copy the values you need into your shell / Tomcat setenv script.
# Never commit a real .env file.

DB_URL=jdbc:mysql://localhost:3306/pharmacy_db?useUnicode=true&characterEncoding=UTF-8
DB_USER=pharmacy_app
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_POOL_SIZE=10

# One-time secret typed on the /setup page to create the first administrator.
# If it is not set, a random token is printed in the Tomcat log at startup.
SETUP_TOKEN=choose-a-long-random-value

# Set to true when the site is served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
